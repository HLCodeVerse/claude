# ==============================================================================
# Evolution API v2 - Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
SERVER_NAME=EvolutionAPI
SERVER_TYPE=http
SERVER_PORT=8080
# For local development: http://localhost:8080
# For Render deployment: https://<your-app-name>.onrender.com
SERVER_URL=http://localhost:8080

# Swagger Documentation UI (available at /docs)
SERVER_DISABLE_DOCS=false

# Evolution Manager Web Dashboard (available at /manager)
SERVER_DISABLE_MANAGER=false

# Logging level (ERROR, WARN, INFO, DEBUG, VERBOSE)
LOG_LEVEL=ERROR,WARN,INFO

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Authentication type: apikey
AUTHENTICATION_TYPE=apikey

# Secret Global API Key required in request headers: "apikey: <your_key>"
# CHANGE THIS TO A STRONG SECRET KEY IN PRODUCTION!
AUTHENTICATION_API_KEY=evol_whatsapp_api_secret_key_2026

# Whether to expose the instance token in GET /instance/fetchInstances
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Set to true if you have a PostgreSQL or MySQL database
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql

# PostgreSQL Connection String:
# For local Docker: postgresql://evolution:evolution_password_secure@postgres:5432/evolution?schema=public
# For Render DB: Use Render Internal/External DB URL
# For Neon/Supabase: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require&schema=public
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_password_secure@localhost:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_v2

# Persistent data options
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# Prevent auto-deletion of disconnected instances
DEL_INSTANCE=false

# ------------------------------------------------------------------------------
# 4. REDIS CACHE CONFIGURATION
# ------------------------------------------------------------------------------
# Set to true if Redis is available for performance and session state caching
CACHE_REDIS_ENABLED=false
CACHE_REDIS_URI=redis://localhost:6379/0
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=true
CACHE_REDIS_TTL=604800

# ------------------------------------------------------------------------------
# 5. GLOBAL WEBHOOK CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# When enabled, all instances will send events to this URL unless individually overridden
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=https://your-webhook-listener.com/webhook
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# Events to trigger webhook:
# APPLICATION_STARTUP, QRCODE_UPDATED, CONNECTION_UPDATE, MESSAGES_SET,
# MESSAGES_UPSERT, MESSAGES_UPDATE, MESSAGES_DELETE, SEND_MESSAGE,
# CONTACTS_SET, CONTACTS_UPSERT, CONTACTS_UPDATE, PRESENCE_UPDATE,
# CHATS_SET, CHATS_UPSERT, CHATS_UPDATE, CHATS_DELETE, GROUPS_UPSERT,
# GROUP_UPDATE, GROUP_PARTICIPANTS_UPDATE, TYPEBOT_START, TYPEBOT_CHANGE_STATUS
WEBHOOK_EVENTS=QRCODE_UPDATED,CONNECTION_UPDATE,MESSAGES_UPSERT,SEND_MESSAGE
