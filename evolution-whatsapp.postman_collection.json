{
  "info": {
    "_postman_id": "a9d3e8f7-9204-44b2-a4f6-evolution-whatsapp-v2",
    "name": "Evolution WhatsApp API v2",
    "description": "Complete collection for Evolution WhatsApp API (Baileys Multi-Device engine)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "evol_whatsapp_api_secret_key_2026",
      "type": "string"
    },
    {
      "key": "instance",
      "value": "my_whatsapp_bot",
      "type": "string"
    },
    {
      "key": "recipientNumber",
      "value": "15551234567",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Server Healthcheck",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "02. Create Instance",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instanceName\": \"{{instance}}\",\n  \"qrcode\": true,\n  \"integration\": \"WHATSAPP-BAILEYS\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/instance/create",
          "host": ["{{baseUrl}}"],
          "path": ["instance", "create"]
        }
      }
    },
    {
      "name": "03. Connect & Get QR Code",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/instance/connect/{{instance}}",
          "host": ["{{baseUrl}}"],
          "path": ["instance", "connect", "{{instance}}"]
        }
      }
    },
    {
      "name": "04. Check Connection State",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/instance/connectionState/{{instance}}",
          "host": ["{{baseUrl}}"],
          "path": ["instance", "connectionState", "{{instance}}"]
        }
      }
    },
    {
      "name": "05. Fetch All Instances",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/instance/fetchInstances",
          "host": ["{{baseUrl}}"],
          "path": ["instance", "fetchInstances"]
        }
      }
    },
    {
      "name": "06. Send Text Message",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"{{recipientNumber}}\",\n  \"text\": \"Hello from Evolution WhatsApp API! 🚀\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/message/sendText/{{instance}}",
          "host": ["{{baseUrl}}"],
          "path": ["message", "sendText", "{{instance}}"]
        }
      }
    },
    {
      "name": "07. Send Media (Image/Video)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"{{recipientNumber}}\",\n  \"mediatype\": \"image\",\n  \"mimetype\": \"image/png\",\n  \"caption\": \"Test image sent via Evolution API\",\n  \"media\": \"https://picsum.photos/400/300\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/message/sendMedia/{{instance}}",
          "host": ["{{baseUrl}}"],
          "path": ["message", "sendMedia", "{{instance}}"]
        }
      }
    },
    {
      "name": "08. Send Audio / Voice Note",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"{{recipientNumber}}\",\n  \"audio\": \"https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3\",\n  \"ptt\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/message/sendWhatsAppAudio/{{instance}}",
          "host": ["{{baseUrl}}"],
          "path": ["message", "sendWhatsAppAudio", "{{instance}}"]
        }
      }
    },
    {
      "name": "09. Configure Webhook",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enabled\": true,\n  \"url\": \"https://webhook.site/replace-with-your-url\",\n  \"webhook_by_events\": false,\n  \"events\": [\n    \"MESSAGES_UPSERT\",\n    \"CONNECTION_UPDATE\",\n    \"SEND_MESSAGE\",\n    \"QRCODE_UPDATED\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/webhook/set/{{instance}}",
          "host": ["{{baseUrl}}"],
          "path": ["webhook", "set", "{{instance}}"]
        }
      }
    },
    {
      "name": "10. Logout / Disconnect",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "apikey", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/instance/logout/{{instance}}",
          "host": ["{{baseUrl}}"],
          "path": ["instance", "logout", "{{instance}}"]
        }
      }
    }
  ]
}
